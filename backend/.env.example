NODE_ENV=development
HOST=127.0.0.1
PORT=5112
MONGO_URI=mongodb://127.0.0.1:27017/school_management
JWT_SECRET=replace-with-a-long-random-development-secret
COOKIE_SECRET=replace-with-a-different-long-random-cookie-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_EXPIRES_IN=8h
JWT_COOKIE_MAX_AGE_MS=28800000
COOKIE_SAMESITE=lax
API_RATE_LIMIT_MAX=600
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_HEADERS_COUNT=100
SUBSCRIPTION_RECONCILE_ENABLED=false
SUBSCRIPTION_RECONCILE_INTERVAL_MINUTES=360
