[Unit]
Description=School Management System
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=schoolapp
Group=schoolapp
WorkingDirectory=/opt/school-management-system/backend
EnvironmentFile=/etc/school-management-system/backend.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=/opt/school-management-system/backend/uploads

[Install]
WantedBy=multi-user.target
