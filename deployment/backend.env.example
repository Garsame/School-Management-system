NODE_ENV=production
HOST=127.0.0.1
PORT=5112
PUBLIC_APP_URL=https://school.elivateict.com
CORS_ORIGINS=https://school.elivateict.com
TRUST_PROXY=loopback

# Preferred: dedicated readWrite application user (see deployment/mongodb/create-users.js).
# URL-encode reserved password characters (@ becomes %40).
MONGO_URI=mongodb://school_app:URL_ENCODED_APP_PASSWORD@127.0.0.1:27017/school_management?authSource=school_management
#
# Maintenance-only alternative (not recommended for the running app):
# MONGO_URI=mongodb://admin:URL_ENCODED_ADMIN_PASSWORD@127.0.0.1:27017/school_management?authSource=admin
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Generate different values with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET_OF_AT_LEAST_32_CHARACTERS
COOKIE_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_COOKIE_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
JWT_COOKIE_MAX_AGE_MS=28800000
COOKIE_SAMESITE=strict

API_RATE_LIMIT_MAX=600
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_HEADERS_COUNT=100

SUBSCRIPTION_RECONCILE_ENABLED=true
SUBSCRIPTION_RECONCILE_INTERVAL_MINUTES=360
